# GitHub configuration
ACCESS_TOKEN=your_github_personal_access_token
REPO_NAME=owner/repository_name

# WakaTime configuration
WAKATIME_API_KEY=your_wakatime_api_key

# Clockify configuration
CLOCKIFY_API_KEY=your_clockify_api_key
CLOCKIFY_WORKSPACE_ID=your_clockify_workspace_id
CLOCKIFY_PROJECT_ID=your_clockify_project_id

# Optional: WakaTime OAuth (if using OAuth instead of API key)
WAKATIME_CLIENT_ID=your_wakatime_client_id
WAKATIME_CLIENT_SECRET=your_wakatime_client_secret
WAKATIME_REDIRECT_URI=your_wakatime_redirect_uri

# Optional: Branch name for testing
BRANCH_NAME=feature/example-branch
WAKATIME_PROJECT=example_project
